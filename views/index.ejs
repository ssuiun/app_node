<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Business Service Platform — Единая система документов</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Serif:wght@600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="bsp-theme.css" />
<script src="/app-theme.js" data-key="bsp_theme"></script>
<style>
  html,body{margin:0;padding:0}
  .bsp-main{overflow:hidden}
  .frame-area{flex:1;position:relative;display:none}
  .frame-area.on{display:block}
  .frame-wrap{position:absolute;inset:0;display:none;background:var(--bsp-cream)}
  .frame-wrap.on{display:block}
  .frame-wrap iframe{width:100%;height:100%;border:none;background:var(--bsp-cream)}
  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:.6rem;color:var(--bsp-muted);font-size:.9rem;background:var(--bsp-cream)}
  .spin{width:18px;height:18px;border:2.5px solid var(--bsp-border);border-top-color:var(--bsp-red-1);border-radius:50%;animation:sp .7s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .home-scroll{flex:1;overflow:auto}
  .home-scroll.hidden{display:none}
  .bsp-hero-quote{display:none}
  @media(min-width:760px){.bsp-hero-quote{display:block}}
  .sb-toggle{position:fixed;top:50%;left:var(--bsp-sidebar-w);transform:translateY(-50%);z-index:50;width:20px;height:64px;padding:0;
    border:1px solid var(--bsp-border);border-left:none;border-radius:0 10px 10px 0;background:var(--bsp-cream);color:var(--bsp-ink-soft);
    font-size:.9rem;line-height:1;cursor:pointer;box-shadow:2px 0 8px rgba(0,0,0,.18)}
  .sb-toggle:hover{background:var(--bsp-cream-2);color:var(--bsp-red-1)}
  .bsp-shell.sb-collapsed .bsp-sidebar{display:none}
  .bsp-shell.sb-collapsed .sb-toggle{left:0}
  @media (max-width:900px){.sb-toggle{display:none}}
  body.tool-open .agentation-host{display:none}
  .bsp-two-col{grid-template-columns:minmax(0,420px)}
  /* Настройки оформления (темы) */
  /* Боковая панель не зависит от темы: возвращаем ей исходную палитру */
  .bsp-sidebar{--bsp-red-1:#7a1420;--bsp-gold:#c9a353;--bsp-cream:#faf6ef;--bsp-cream-2:#f3ead9;--bsp-paper:#fffdf8;--bsp-border:#e7d9c0;--bsp-ink:#2b1c14;--bsp-ink-soft:#5b4638;--bsp-muted:#8a7561}
  .home-tools{display:flex;justify-content:flex-end;margin-bottom:.8rem}
  .set-btn{border:1px solid var(--bsp-border);background:var(--bsp-paper);color:var(--bsp-ink-soft);border-radius:var(--bsp-radius-sm);padding:.4rem .8rem;font:inherit;font-size:.82rem;font-weight:600;cursor:pointer}
  .set-btn:hover{border-color:var(--bsp-gold);color:var(--bsp-red-1)}
  #dlg-settings{border:1px solid var(--bsp-border);border-radius:18px;padding:1.5rem;width:min(460px,94vw);background:var(--bsp-paper);color:var(--bsp-ink);font-family:var(--bsp-font-body);margin:auto;box-shadow:0 20px 70px rgba(0,0,0,.45)}
  #dlg-settings::backdrop{background:rgba(0,0,0,.6);backdrop-filter:blur(6px)}
  #dlg-settings h3{margin:0 0 .9rem;font-size:1.1rem}
  #dlg-settings .lbl{font-size:.8rem;font-weight:500;color:var(--bsp-ink-soft)}
  .theme-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:.5rem}
  .theme-opt{display:flex;align-items:center;gap:.6rem;padding:.7rem .85rem;border:1px solid var(--bsp-border);border-radius:8px;cursor:pointer;font-size:.85rem;color:var(--bsp-ink-soft);background:none;font-family:inherit;text-align:left}
  .theme-opt:hover{border-color:var(--bsp-gold);color:var(--bsp-ink)}
  .theme-opt.sel{border-color:var(--bsp-red-1);background:color-mix(in srgb,var(--bsp-red-1) 12%,transparent);color:var(--bsp-ink)}
  .theme-sw{width:26px;height:26px;border-radius:50%;flex-shrink:0;border:2px solid rgba(255,255,255,.25)}
  .set-actions{display:flex;justify-content:flex-end;margin-top:1.1rem}
  .set-actions button{border:none;border-radius:8px;padding:.55rem 1.3rem;font:inherit;font-weight:600;font-size:.87rem;cursor:pointer;background:linear-gradient(135deg,var(--bsp-red-1),color-mix(in srgb,var(--bsp-red-1) 58%,#000));color:#fff}
  .bsp-logo-spacer{height:150px}
  @media (max-width:900px){.bsp-logo-spacer{display:none}}

  .bsp-mini-cal{display:flex;flex-direction:column;gap:.7rem}
  .bsp-mini-cal .mc-head{display:flex;align-items:center;justify-content:space-between}
  .bsp-mini-cal .mc-head .mc-title{font-weight:700;font-size:.92rem;text-transform:capitalize}
  .bsp-mini-cal .mc-nav{display:flex;gap:.3rem}
  .bsp-mini-cal .mc-nav button{
    width:24px;height:24px;border:1px solid var(--bsp-border);background:var(--bsp-cream-2);border-radius:6px;
    cursor:pointer;color:var(--bsp-ink-soft);font-size:.8rem;line-height:1;display:flex;align-items:center;justify-content:center;
  }
  .bsp-mini-cal .mc-nav button:hover{background:var(--bsp-border)}
  .bsp-mini-cal .mc-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center}
  .bsp-mini-cal .mc-dow{font-size:.65rem;color:var(--bsp-muted);font-weight:700;padding:.2rem 0;text-transform:uppercase}
  .bsp-mini-cal .mc-day{font-size:.78rem;padding:.4rem 0;border-radius:7px;color:var(--bsp-ink-soft)}
  .bsp-mini-cal .mc-day.mc-muted{color:var(--bsp-border)}
  .bsp-mini-cal .mc-day.mc-today{background:var(--bsp-red-1);color:#fff;font-weight:700}
</style>
</head>
<body>

<div class="bsp-shell bsp-reset">

  <aside class="bsp-sidebar">
    <div class="bsp-logo-spacer" aria-hidden="true"></div>

    <nav class="bsp-nav" aria-label="Инструменты">
      <a href="javascript:void(0)" id="nav-home" onclick="goHome()"><span class="ic">🏠</span>Главная</a>
      <a href="javascript:void(0)" id="nav-akt" onclick="openTool('akt')"><span class="ic">📑</span>Акт приёма-передачи</a>
      <a href="javascript:void(0)" id="nav-viz" onclick="openTool('viz')"><span class="ic">🛂</span>Визы и договоры</a>
      <a href="javascript:void(0)" id="nav-kadr" onclick="openTool('kadr')"><span class="ic">👥</span>Кадровые приказы</a>
      <a href="javascript:void(0)" id="nav-cli" onclick="openTool('cli')"><span class="ic">🗂️</span>Клиенты</a>
      <a href="javascript:void(0)" id="nav-out" onclick="openTool('out')"><span class="ic">📨</span>Исходящие номера</a>
      <a href="javascript:void(0)" id="nav-marg" onclick="openTool('marg')"><span class="ic">✅</span>Лист задач</a>
      <a href="javascript:void(0)" id="nav-pdf" onclick="openTool('pdf')"><span class="ic">📄</span>PDF-инструменты</a>
    </nav>

    <div class="bsp-sidebar-spacer"></div>

    <div class="bsp-quote">
      «Улук иштер кичине кадамдардан башталат.»
      <span class="dash">— Кыргыз накыл сөзү</span>
    </div>

    <div class="bsp-user">
      <div class="av">S</div>
      <div>
        <div class="name">Sui</div>
        <div class="role">Business Service Platform</div>
      </div>
    </div>
  </aside>

  <button type="button" class="sb-toggle" id="sb-toggle" onclick="toggleSidebar()" aria-label="Скрыть боковую панель" title="Скрыть/показать боковую панель">‹</button>

  <div class="bsp-main">
    <div class="home-scroll" id="home-view">
      <div class="bsp-content">
        <div class="home-tools"><button type="button" class="set-btn" id="btn-settings" title="Настройки оформления" aria-label="Настройки оформления">⚙️ Оформление</button></div>
        <div class="bsp-grid-4">
          <div class="bsp-tool-card" onclick="openTool('akt')">
            <div class="icon" style="background:linear-gradient(135deg,#c62330,#9c1a22)">📑</div>
            <div class="title">Акт приёма-передачи</div>
            <div class="desc">Создание и заполнение актов документов</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('viz')">
            <div class="icon" style="background:linear-gradient(135deg,var(--bsp-gold-soft),var(--bsp-gold-deep))">🛂</div>
            <div class="title">Визы и договоры</div>
            <div class="desc">Заявления, обязательства, трудовые договоры</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('kadr')">
            <div class="icon" style="background:linear-gradient(135deg,#7a3a20,#4a2410)">👥</div>
            <div class="title">Кадровые приказы</div>
            <div class="desc">Приём, увольнение и кадровые документы</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('cli')">
            <div class="icon" style="background:linear-gradient(135deg,#8a5a2b,#5a3a1a)">🗂️</div>
            <div class="title">Клиенты</div>
            <div class="desc">База данных: карточки компаний и клиентов</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('out')">
            <div class="icon" style="background:linear-gradient(135deg,#3d5a80,#26394f)">📨</div>
            <div class="title">Исходящие номера</div>
            <div class="desc">Автоматическая нумерация писем и журнал по каждой компании</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('marg')">
            <div class="icon" style="background:linear-gradient(135deg,#2e7d5b,#1e5a40)">✅</div>
            <div class="title">Лист задач</div>
            <div class="desc">Личный список задач с комментариями и дедлайнами</div>
            <div class="go">Открыть →</div>
          </div>
          <div class="bsp-tool-card" onclick="openTool('pdf')">
            <div class="icon" style="background:linear-gradient(135deg,#b3392f,#7a2020)">📄</div>
            <div class="title">PDF-инструменты</div>
            <div class="desc">Объединение, разделение, сжатие, конвертация и OCR PDF</div>
            <div class="go">Открыть →</div>
          </div>
        </div>

        <div class="bsp-two-col">
          <div class="bsp-panel bsp-mini-cal" id="mini-cal">
            <div class="mc-head">
              <span class="mc-title">📅 <span id="mc-title-text"></span></span>
              <div class="mc-nav">
                <button type="button" onclick="miniCalShift(-1)" aria-label="Предыдущий месяц">‹</button>
                <button type="button" onclick="miniCalShift(1)" aria-label="Следующий месяц">›</button>
              </div>
            </div>
            <div class="mc-grid" id="mc-grid"></div>
          </div>
        </div>
      </div>
    </div>

    <main class="frame-area" id="frame-area">
      <div class="frame-wrap" id="wrap-akt">
        <div class="loading" id="load-akt"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-akt" title="Акт приёма-передачи документов"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-viz">
        <div class="loading" id="load-viz"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-viz" title="Визы и договоры"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-kadr">
        <div class="loading" id="load-kadr"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-kadr" title="Кадровые приказы"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-cli">
        <div class="loading" id="load-cli"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-cli" title="Клиенты"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-out">
        <div class="loading" id="load-out"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-out" title="Исходящие номера"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-marg">
        <div class="loading" id="load-marg"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-marg" title="Лист задач"></iframe>
      </div>
      <div class="frame-wrap" id="wrap-pdf">
        <div class="loading" id="load-pdf"><div class="spin"></div>Загрузка…</div>
        <iframe id="frame-pdf" title="PDF-инструменты"></iframe>
      </div>
    </main>
  </div>
</div>

<dialog id="dlg-settings">
  <h3>⚙️ Настройки оформления</h3>
  <div class="lbl">Цветовая тема приложения</div>
  <div class="theme-grid" id="theme-grid"></div>
  <div class="set-actions"><button type="button" id="settings-close">Готово</button></div>
</dialog>

<script>
  /* ---- Настройки оформления ---- */
  document.getElementById('btn-settings').onclick = function(){ AppTheme.renderGrid(); document.getElementById('dlg-settings').showModal(); };
  document.getElementById('settings-close').onclick = function(){ document.getElementById('dlg-settings').close(); };
  document.getElementById('theme-grid').addEventListener('click', function(e){ var b = e.target.closest('[data-theme]'); if (b) AppTheme.apply(b.getAttribute('data-theme')); });

  var SRC = { akt:'akt.html', viz:'visa.html', kadr:'kadr.html', marg:'marginalia.html', out:'outgoing.html', cli:'clients.html', pdf:'pdf/' };
  var loaded = { akt:false, viz:false, kadr:false, marg:false, out:false, cli:false, pdf:false };
  var NAVS = ['home','akt','viz','kadr','cli','out','marg','pdf'];

  function toggleSidebar(force){
    var shell = document.querySelector('.bsp-shell');
    var collapsed = typeof force === 'boolean' ? force : !shell.classList.contains('sb-collapsed');
    shell.classList.toggle('sb-collapsed', collapsed);
    var b = document.getElementById('sb-toggle');
    b.textContent = collapsed ? '›' : '‹';
    b.setAttribute('aria-label', collapsed ? 'Показать боковую панель' : 'Скрыть боковую панель');
    try { localStorage.setItem('bsp_sidebar_collapsed', collapsed ? '1' : '0'); } catch(e){}
  }
  try { if (localStorage.getItem('bsp_sidebar_collapsed') === '1') toggleSidebar(true); } catch(e){}

  function setActiveNav(key){
    NAVS.forEach(function(k){
      var el = document.getElementById('nav-'+k);
      if (el) el.classList.toggle('active', k===key);
    });
  }

  function goHome(){
    document.getElementById('home-view').classList.remove('hidden');
    document.getElementById('frame-area').classList.remove('on');
    document.body.classList.remove('tool-open');
    setActiveNav('home');
    try { history.replaceState(null, '', '#home'); } catch(e){}
  }

  function openTool(key){
    if (!SRC[key]) return;
    document.getElementById('home-view').classList.add('hidden');
    document.getElementById('frame-area').classList.add('on');
    ['akt','viz','kadr','cli','out','marg','pdf'].forEach(function(k){
      document.getElementById('wrap-'+k).classList.toggle('on', k===key);
    });
    document.body.classList.add('tool-open');
    setActiveNav(key);

    if (!loaded[key]){
      var f = document.getElementById('frame-'+key);
      f.addEventListener('load', function onload(){
        var l = document.getElementById('load-'+key);
        if (l) l.style.display = 'none';
        f.removeEventListener('load', onload);
      });
      f.src = SRC[key];
      loaded[key] = true;
    }
    try { history.replaceState(null, '', '#' + key); } catch(e){}
  }

  (function initFromHash(){
    var h = (location.hash || '').replace('#','');
    if (SRC[h]) { openTool(h); } else { goHome(); }
  })();

  /* ---- Mini calendar ---- */
  var MC_DOW = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
  var MC_MONTHS = ['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
  var today = new Date();
  var mcYear = today.getFullYear(), mcMonth = today.getMonth();

  function miniCalShift(delta){
    mcMonth += delta;
    if (mcMonth < 0) { mcMonth = 11; mcYear--; }
    if (mcMonth > 11) { mcMonth = 0; mcYear++; }
    renderMiniCal();
  }

  function renderMiniCal(){
    var titleEl = document.getElementById('mc-title-text');
    var gridEl = document.getElementById('mc-grid');
    if (!titleEl || !gridEl) return;
    titleEl.textContent = MC_MONTHS[mcMonth] + ' ' + mcYear;

    var html = MC_DOW.map(function(d){ return '<div class="mc-dow">' + d + '</div>'; }).join('');

    var firstDay = new Date(mcYear, mcMonth, 1);
    var startOffset = (firstDay.getDay() + 6) % 7; // Monday = 0
    var daysInMonth = new Date(mcYear, mcMonth + 1, 0).getDate();
    var daysInPrevMonth = new Date(mcYear, mcMonth, 0).getDate();

    for (var i = 0; i < startOffset; i++){
      html += '<div class="mc-day mc-muted">' + (daysInPrevMonth - startOffset + i + 1) + '</div>';
    }
    for (var d2 = 1; d2 <= daysInMonth; d2++){
      var isToday = (d2 === today.getDate() && mcMonth === today.getMonth() && mcYear === today.getFullYear());
      html += '<div class="mc-day' + (isToday ? ' mc-today' : '') + '">' + d2 + '</div>';
    }
    var totalCells = startOffset + daysInMonth;
    var trailing = (7 - (totalCells % 7)) % 7;
    for (var d3 = 1; d3 <= trailing; d3++){
      html += '<div class="mc-day mc-muted">' + d3 + '</div>';
    }

    gridEl.innerHTML = html;
  }

  renderMiniCal();
</script>

</body>
</html>
