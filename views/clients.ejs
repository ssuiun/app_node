<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Клиенты</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  :root{--bg:#faf6ef;--bg2:#f3ead9;--card:#fffdf8;--card2:#f3ead9;--border:#e7d9c0;--border2:#d9c6a3;--acc:#9c1a22;--acc2:#c9a353;--acc3:#2e8b57;--txt:#2b1c14;--txt2:#6b5644;--muted:#8a7561;--r:14px;--rs:8px;--tr:.22s cubic-bezier(.4,0,.2,1);--hdr1:#8c1220;--hdr2:#5c0f14;--hdr-txt:#fff;--glow:0 0 18px rgba(156,26,34,.22)}
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  [hidden]{display:none!important}
  a.btn{text-decoration:none}
  body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;line-height:1.6}
  header{background:linear-gradient(135deg,var(--hdr1),var(--hdr2));border-bottom:1px solid var(--border);padding:0 1.5rem;position:sticky;top:0;z-index:100;color:var(--hdr-txt);transition:background .3s ease}
  .hdr{max-width:1320px;margin:0 auto;display:flex;align-items:center;gap:1.5rem;min-height:62px;flex-wrap:wrap;padding:.4rem 0}
  .logo{display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:1.05rem;white-space:nowrap}
  .logo-i{width:34px;height:34px;background:linear-gradient(135deg,var(--acc),var(--acc2));border:1.5px solid var(--acc2);border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:var(--glow2,none)}
  .tabs{display:flex;gap:.2rem;margin-left:auto;flex-wrap:wrap}
  .tb{padding:.45rem 1rem;border:1px solid transparent;background:transparent;color:color-mix(in srgb,var(--hdr-txt) 78%,transparent);cursor:pointer;border-radius:var(--rs);font:inherit;font-size:.83rem;font-weight:500;transition:color var(--tr),background var(--tr);white-space:nowrap}
  .tb:hover{color:var(--hdr-txt);background:color-mix(in srgb,var(--hdr-txt) 12%,transparent)}
  .tb.on{color:#fff;background:linear-gradient(135deg,var(--acc),var(--acc2));box-shadow:var(--glow);font-weight:700}
  .badge{display:inline-block;background:color-mix(in srgb,var(--hdr-txt) 18%,transparent);border-radius:20px;padding:0 6px;font-size:.72rem;margin-left:4px}
  .btn-settings{flex-shrink:0;padding:.42rem .6rem;font-size:1rem;margin-left:-.5rem}
  .wrap{max-width:1320px;margin:0 auto;padding:1.5rem 1.75rem}
  .panel{display:none}.panel.on{display:block}
  .ptitle{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.1rem}
  .ptitle h1{font-size:1.7rem;font-weight:800;letter-spacing:-.01em;line-height:1.2}
  .ptitle p{color:var(--txt2);font-size:.87rem}
  label{display:block;font-size:.8rem;font-weight:500;color:var(--txt2);margin:.8rem 0 .3rem}
  input,select,textarea{width:100%;padding:.6rem .8rem;background:var(--bg2);border:1px solid var(--border);border-radius:var(--rs);color:var(--txt);font:inherit;font-size:.88rem;outline:none}
  input:focus,select:focus,textarea:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(156,26,34,.15)}
  textarea{resize:vertical;min-height:64px}
  .row{display:flex;gap:.7rem}.row>*{flex:1;min-width:0}
  .err{color:#b3261e;font-size:.82rem;margin-top:.6rem;min-height:1em}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.6rem 1.2rem;border:none;border-radius:var(--rs);cursor:pointer;font:inherit;font-size:.87rem;font-weight:600;white-space:nowrap;background:linear-gradient(135deg,var(--acc),color-mix(in srgb,var(--acc) 62%,#000));color:#fff;transition:filter var(--tr),transform 160ms}
  .btn:hover{filter:brightness(1.1)}.btn:active{transform:translateY(1px)}.btn:disabled{opacity:.5;pointer-events:none}
  .btn.ghost{background:var(--card);color:var(--txt);border:1px solid var(--border2)}
  .btn.danger{background:var(--card);color:#b3261e;border:1px solid #e3b4b0}
  .btn.sm{padding:.25rem .65rem;font-size:.76rem}
  .toolbar{display:flex;gap:.7rem;margin-bottom:1rem;flex-wrap:wrap;align-items:center}
  .toolbar input[type=search]{max-width:380px;flex:1;min-width:200px}
  .toolbar select{max-width:280px}
  .cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:.9rem}
  .cc{background:var(--card);border:1px solid var(--border);border-top:2px solid var(--acc2);border-radius:var(--r);padding:1rem 1.1rem;cursor:pointer;transition:border-color var(--tr),transform var(--tr),box-shadow var(--tr);display:flex;flex-direction:column;gap:.5rem;min-width:0}
  .cc:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 10px 24px -14px rgba(60,20,10,.45)}
  .cc:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
  .cc .nm{font-weight:700;font-size:.97rem;line-height:1.3;word-break:break-word}
  .cc .full{color:var(--muted);font-size:.76rem;line-height:1.35}
  .ir{display:flex;gap:.5rem;font-size:.82rem;line-height:1.35}
  .ir .il{color:var(--muted);min-width:78px;flex-shrink:0;font-size:.74rem;padding-top:.05rem}
  .ir span:last-child{word-break:break-word;min-width:0}
  .chips{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.1rem}
  .chip{background:var(--bg2);border:1px solid var(--border);border-radius:20px;padding:0 .6rem;font-size:.74rem;color:var(--txt2);font-family:inherit}
  button.chip{cursor:pointer}button.chip:hover{border-color:var(--acc);color:var(--acc)}
  .chip b{color:var(--acc)}
  .viewsw{display:inline-flex;margin-left:auto;border:1px solid var(--border2);border-radius:var(--rs);overflow:hidden;flex-shrink:0}
  .viewsw button{border:none;background:var(--card);color:var(--txt2);padding:.45rem .8rem;font:inherit;font-size:.8rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.35rem}
  .viewsw button+button{border-left:1px solid var(--border2)}
  .viewsw button.on{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff}
  .list{overflow:auto;background:var(--card);border:1px solid var(--border);border-top:2px solid var(--acc2);border-radius:var(--r)}
  table{width:100%;border-collapse:collapse;font-size:.85rem}
  th{text-align:left;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:.6rem .7rem;border-bottom:2px solid var(--border);white-space:nowrap}
  td{padding:.55rem .7rem;border-bottom:1px solid var(--border);vertical-align:top}
  tr[data-comp],tr[data-cli]{cursor:pointer}
  tr[data-comp]:hover td,tr[data-cli]:hover td{background:color-mix(in srgb,var(--acc2) 10%,transparent)}
  tr:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
  td.nm{font-weight:700;min-width:180px}
  .sub{color:var(--muted);font-size:.76rem;font-weight:400}
  .flist{margin-top:.5rem;border:1px solid var(--border);border-radius:var(--rs);background:var(--bg2)}
  .frow{display:flex;align-items:center;gap:.5rem;padding:.45rem .7rem;border-top:1px solid var(--border);font-size:.82rem}
  .frow:first-child{border-top:none}
  .frow .fn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hint{color:var(--muted);font-size:.76rem;margin-top:.3rem}
  .card{background:var(--card);border:1px solid var(--border);border-top:2px solid var(--acc2);border-radius:var(--r);padding:1.2rem}
  .ct{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.4rem;display:flex;align-items:center;gap:.45rem}
  .crumbs{display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem}
  .cd-actions{display:flex;gap:.5rem;flex-wrap:wrap}
  .detail-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:1.1rem;align-items:start}
  .detail-grid .side{display:flex;flex-direction:column;gap:1.1rem}
  @media(max-width:900px){.detail-grid{grid-template-columns:1fr}}
  .fgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 .9rem}
  .fgrid .span2{grid-column:1/-1}
  @media(max-width:560px){.fgrid{grid-template-columns:1fr}}
  .mini{display:flex;align-items:center;gap:.6rem;padding:.55rem .2rem;border-top:1px solid var(--border);cursor:pointer;font-size:.85rem}
  .mini:first-child{border-top:none}.mini:hover{color:var(--acc)}
  .mini .sub{margin-left:auto}
  .more{display:flex;justify-content:center;margin-top:1.1rem}
  .empty{padding:2rem 1rem;text-align:center;color:var(--muted);grid-column:1/-1}
  dialog{border:1px solid var(--border);border-radius:var(--r);padding:1.3rem;width:min(560px,94vw);max-height:92vh;overflow:auto;background:var(--card);color:var(--txt);margin:auto}
  dialog::backdrop{background:rgba(30,10,8,.5)}
  dialog h3{font-size:1.15rem;margin-bottom:.2rem}
  .dlg-actions{display:flex;justify-content:flex-end;gap:.5rem;margin-top:1.1rem;flex-wrap:wrap}
  .theme-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:.5rem}
  .theme-opt{display:flex;align-items:center;gap:.6rem;padding:.7rem .85rem;border:1px solid var(--border);border-radius:var(--rs);cursor:pointer;transition:border-color var(--tr),background var(--tr);font-size:.85rem;color:var(--txt2);background:none;font-family:inherit;text-align:left}
  .theme-opt:hover{border-color:var(--border2);color:var(--txt)}
  .theme-opt.sel{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,transparent);color:var(--txt)}
  .theme-sw{width:26px;height:26px;border-radius:50%;flex-shrink:0;border:2px solid rgba(255,255,255,.25)}
  .toast{position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);background:#2b1c14;color:#fff;padding:.6rem 1.1rem;border-radius:var(--rs);font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:300}
  .toast.on{opacity:1}
  @media(max-width:560px){.row{flex-direction:column;gap:0}.wrap{padding:1rem}}
</style>
<script src="/app-theme.js" data-key="cl_theme"></script>
</head>
<body>
<header id="app-header">
  <div class="hdr">
    <div class="logo"><div class="logo-i" aria-hidden="true"><svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" fill="none" stroke-width="7" stroke-linecap="round" style="width:62%;height:62%"><circle cx="50" cy="50" r="44"/><circle cx="50" cy="50" r="18"/><line x1="50" y1="6" x2="50" y2="94"/><line x1="6" y1="50" x2="94" y2="50"/><line x1="18.5" y1="18.5" x2="81.5" y2="81.5"/><line x1="81.5" y1="18.5" x2="18.5" y2="81.5"/></svg></div>Клиенты</div>
    <nav class="tabs">
      <button class="tb on" id="tab-comp" type="button">🏢 Компании <span class="badge" id="comp-count">0</span></button>
      <button class="tb" id="tab-cli" type="button">👤 Клиенты <span class="badge" id="cli-count">0</span></button>
    </nav>
    <button class="btn ghost btn-settings" id="btn-settings" type="button" title="Настройки оформления" aria-label="Настройки оформления">⚙️</button>
  </div>
</header>

<main class="wrap">
  <!-- КОМПАНИИ -->
  <section class="panel on" id="panel-comp">
    <div class="ptitle">
      <div><h1>Компании</h1><p>Карточки компаний с реквизитами. Нажмите на карточку, чтобы открыть или изменить.</p></div>
      <button class="btn" id="btn-add-comp" type="button">＋ Компания</button>
    </div>
    <div class="toolbar">
      <input id="comp-q" type="search" placeholder="Поиск: название, ИНН, директор, адрес…" aria-label="Поиск компаний" />
      <button class="btn ghost" id="btn-import" type="button" title="Добавить компании из раздела «Визы и договоры». Уже добавленные не меняются.">⬇ Импорт из «Визы и договоры»</button>
      <div class="viewsw" role="group" aria-label="Вид"><button type="button" data-view="cards" title="Карточками">▦ Карточки</button><button type="button" data-view="list" title="Списком">☰ Список</button></div>
    </div>
    <div class="cgrid" id="comp-grid"></div>
    <div class="more"><button class="btn ghost" id="comp-more" type="button" hidden>Показать ещё</button></div>
  </section>

  <!-- КЛИЕНТЫ -->
  <section class="panel" id="panel-cli">
    <div class="ptitle">
      <div><h1>Клиенты</h1><p>Карточки клиентов с контактами и привязкой к компании.</p></div>
      <button class="btn" id="btn-add-cli" type="button">＋ Клиент</button>
    </div>
    <div class="toolbar">
      <input id="cli-q" type="search" placeholder="Поиск: ФИО, телефон, компания, паспорт…" aria-label="Поиск клиентов" />
      <select id="cli-company" aria-label="Фильтр по компании"></select>
      <div class="viewsw" role="group" aria-label="Вид"><button type="button" data-view="cards" title="Карточками">▦ Карточки</button><button type="button" data-view="list" title="Списком">☰ Список</button></div>
    </div>
    <div class="cgrid" id="cli-grid"></div>
    <div class="more"><button class="btn ghost" id="cli-more" type="button" hidden>Показать ещё</button></div>
  </section>
<!-- ══ Страница компании ══ -->
<section class="panel" id="panel-company">
  <div class="crumbs"><button class="btn ghost sm" id="dc-back" type="button">← Все компании</button></div>
  <div class="ptitle">
    <div><h1 id="dc-title">Компания</h1><p id="dc-sub"></p></div>
    <div class="cd-actions">
      <button class="btn danger" id="dc-del" type="button">🗑 Удалить</button>
      <button class="btn" id="dc-save" type="button">Сохранить</button>
    </div>
  </div>
  <div class="detail-grid">
    <div class="card">
      <div class="ct">Данные компании</div>
      <div class="fgrid">
        <div class="span2"><label for="c-name">Название *</label><input id="c-name" maxlength="200" /></div>
        <div class="span2"><label for="c-full_name">Полное название</label><input id="c-full_name" maxlength="400" placeholder="Общество с ограниченной ответственностью «…»" /></div>
        <div><label for="c-inn">ИНН</label><input id="c-inn" maxlength="50" /></div>
        <div><label for="c-okpo">ОКПО</label><input id="c-okpo" maxlength="50" /></div>
        <div class="span2"><label for="c-director">Директор</label><input id="c-director" maxlength="200" /></div>
        <div class="span2"><label for="c-address">Адрес</label><input id="c-address" maxlength="400" /></div>
        <div><label for="c-phone">Телефон</label><input id="c-phone" maxlength="100" inputmode="tel" /></div>
        <div><label for="c-email">Email</label><input id="c-email" maxlength="200" inputmode="email" /></div>
        <div class="span2"><label for="c-activity">Вид деятельности</label><input id="c-activity" maxlength="400" /></div>
        <div class="span2"><label for="c-info">Регистрация</label><input id="c-info" maxlength="1000" placeholder="зарегистрировано … года, регистрационный №…" /></div>
        <div class="span2"><label for="c-notes">Примечание</label><textarea id="c-notes" maxlength="2000"></textarea></div>
      </div>
      <div class="err" id="dc-err" role="alert"></div>
    </div>
    <div class="side">
      <div class="card">
        <div class="ct">Файлы</div>
        <div class="flist" id="c-files"></div>
        <input type="file" id="c-addfile" multiple style="margin-top:.6rem" />
        <div class="hint" id="c-files-hint"></div>
      </div>
      <div class="card" id="dc-clients-card">
        <div class="ct">Клиенты компании <button class="btn ghost sm" id="dc-add-client" type="button" style="margin-left:auto">＋ Клиент</button></div>
        <div id="dc-clients"></div>
      </div>
    </div>
  </div>
</section>

<!-- ══ Страница клиента ══ -->
<section class="panel" id="panel-client">
  <div class="crumbs"><button class="btn ghost sm" id="dl-back" type="button">← Все клиенты</button></div>
  <div class="ptitle">
    <div><h1 id="dl-title">Клиент</h1><p id="dl-sub"></p></div>
    <div class="cd-actions">
      <button class="btn ghost" id="dl-open-co" type="button" hidden>🏢 Открыть компанию</button>
      <button class="btn danger" id="dl-del" type="button">🗑 Удалить</button>
      <button class="btn" id="dl-save" type="button">Сохранить</button>
    </div>
  </div>
  <div class="detail-grid">
    <div class="card">
      <div class="ct">Данные клиента</div>
      <div class="fgrid">
        <div class="span2"><label for="k-name">ФИО *</label><input id="k-name" maxlength="200" /></div>
        <div><label for="k-company_id">Компания</label><select id="k-company_id"></select></div>
        <div><label for="k-position">Должность</label><input id="k-position" maxlength="200" /></div>
        <div><label for="k-phone">Телефон</label><input id="k-phone" maxlength="100" inputmode="tel" /></div>
        <div><label for="k-email">Email</label><input id="k-email" maxlength="200" inputmode="email" /></div>
        <div><label for="k-citizenship">Гражданство</label><input id="k-citizenship" maxlength="100" /></div>
        <div><label for="k-passport">Паспорт</label><input id="k-passport" maxlength="100" /></div>
        <div class="span2"><label for="k-notes">Примечание</label><textarea id="k-notes" maxlength="2000"></textarea></div>
      </div>
      <div class="err" id="dl-err" role="alert"></div>
    </div>
    <div class="side">
      <div class="card">
        <div class="ct">Файлы</div>
        <div class="flist" id="k-files"></div>
        <input type="file" id="k-addfile" multiple style="margin-top:.6rem" />
        <div class="hint" id="k-files-hint"></div>
      </div>
    </div>
  </div>
</section>
</main>

<dialog id="dlg-settings">
  <h3>⚙️ Настройки оформления</h3>
  <label>Цветовая тема приложения</label>
  <div class="theme-grid" id="theme-grid"></div>
  <div class="dlg-actions"><button class="btn" id="settings-close" type="button">Готово</button></div>
</dialog>

<div class="toast" id="toast" role="status"></div>

<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var PAGE = 60;
  var COMP_FIELDS = ['name','full_name','inn','okpo','director','address','phone','email','activity','info','notes'];
  var CLI_FIELDS = ['name','position','phone','email','citizenship','passport','notes'];
  var options = [];                       // компании для выпадающих списков
  var comp = { items: [], total: 0 }, cli = { items: [], total: 0 };
  var view = 'cards', maxFileMb = 25, dataLoaded = false;
  try { if ((localStorage.getItem('bsp_view') || localStorage.getItem('cl_view')) === 'list') view = 'list'; } catch(e){}

  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  var toastT;
  function toast(t){ var el = $('toast'); el.textContent = t; el.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(function(){ el.classList.remove('on'); }, 2600); }
  function api(method, url, body){
    return fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: body ? JSON.stringify(body) : undefined })
      .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ if (!r.ok) throw new Error(j.error || ('Ошибка ' + r.status)); return j; }); });
  }
  function row(label, val){ return val ? '<div class="ir"><span class="il">' + label + '</span><span>' + esc(val) + '</span></div>' : ''; }

  // ----- вкладки и страницы (маршрутизация через #hash, работает кнопка «Назад» браузера) -----
  var PANELS = ['comp','cli','company','client'];
  var cur = { kind: null, rec: null, dirty: false };   // открытая страница карточки
  function showPanel(name){
    PANELS.forEach(function(p){ $('panel-' + p).classList.toggle('on', p === name); });
    var tab = name === 'company' ? 'comp' : name === 'client' ? 'cli' : name;
    $('tab-comp').classList.toggle('on', tab === 'comp'); $('tab-cli').classList.toggle('on', tab === 'cli');
  }
  function confirmLeave(){ return !cur.dirty || confirm('Есть несохранённые изменения. Уйти без сохранения?'); }
  function go(hash){ if (!confirmLeave()) return; cur.dirty = false; if (location.hash.replace('#','') === hash) route(); else location.hash = hash; }
  $('tab-comp').onclick = function(){ go('comp'); };
  $('tab-cli').onclick = function(){ go('cli'); };
  window.addEventListener('beforeunload', function(e){ if (cur.dirty) { e.preventDefault(); e.returnValue = ''; } });
  window.addEventListener('hashchange', route);
  document.addEventListener('input', function(e){ if (e.target.closest('#panel-company, #panel-client')) cur.dirty = true; });
  document.addEventListener('change', function(e){ if (e.target.closest('#k-company_id')) cur.dirty = true; });

  // ----- справочник компаний для списков -----
  function loadOptions(){
    return api('GET', '/api/clients/companies/options').then(function(list){
      options = list;
      var cur = $('cli-company').value;
      $('cli-company').innerHTML = '<option value="">Все компании</option><option value="none">Без компании</option>' +
        list.map(function(c){ return '<option value="' + c.id + '">' + esc(c.name) + '</option>'; }).join('');
      $('cli-company').value = cur;
    });
  }
  function companySelectHtml(selected){
    return '<option value="">— без компании —</option>' + options.map(function(c){ return '<option value="' + c.id + '"' + (String(c.id) === String(selected) ? ' selected' : '') + '>' + esc(c.name) + '</option>'; }).join('');
  }

  // ----- карточки компаний -----
  function cardComp(c, i){
    return '<div class="cc" tabindex="0" role="button" data-comp="' + i + '"><div class="nm">' + esc(c.name) + '</div>' +
      (c.full_name && c.full_name !== c.name ? '<div class="full">' + esc(c.full_name) + '</div>' : '') +
      row('Директор', c.director) + row('ИНН', c.inn) + row('ОКПО', c.okpo) + row('Адрес', c.address) + row('Телефон', c.phone) + row('Email', c.email) +
      (c.activity ? '<div class="chips"><span class="chip">' + esc(c.activity.length > 60 ? c.activity.slice(0, 60) + '…' : c.activity) + '</span></div>' : '') +
      '<div class="chips"><button type="button" class="chip" data-clients="' + c.id + '" title="Показать клиентов компании">Клиенты: <b>' + c.clients_count + '</b></button>' +
      (c.files_count ? '<span class="chip">📎 ' + c.files_count + '</span>' : '') + '</div></div>';
  }
  function rowComp(c, i){
    return '<tr tabindex="0" role="button" data-comp="' + i + '"><td class="nm">' + esc(c.name) + (c.full_name && c.full_name !== c.name ? '<div class="sub">' + esc(c.full_name) + '</div>' : '') + '</td>' +
      '<td>' + esc(c.inn) + '</td><td>' + esc(c.okpo) + '</td><td>' + esc(c.director) + '</td><td>' + esc(c.address) + '</td>' +
      '<td><button type="button" class="chip" data-clients="' + c.id + '" title="Показать клиентов компании">' + c.clients_count + '</button></td>' +
      '<td>' + (c.files_count ? '📎 ' + c.files_count : '') + '</td></tr>';
  }
  function rowCli(k, i){
    return '<tr tabindex="0" role="button" data-cli="' + i + '"><td class="nm">' + esc(k.name) + '</td>' +
      '<td>' + (k.company_id ? '<button type="button" class="chip" data-gocomp="' + k.company_id + '" title="Открыть компанию">🏢 ' + esc(k.company_name) + '</button>' : '<span class="sub">—</span>') + '</td>' +
      '<td>' + esc(k.position) + '</td><td>' + esc(k.phone) + '</td><td>' + esc(k.email) + '</td><td>' + esc(k.passport) + '</td>' +
      '<td>' + (k.files_count ? '📎 ' + k.files_count : '') + '</td></tr>';
  }
  function tableHtml(head, rows){ return '<table><thead><tr>' + head.map(function(h){ return '<th>' + h + '</th>'; }).join('') + '</tr></thead><tbody>' + rows + '</tbody></table>'; }
  function renderComp(){
    var el = $('comp-grid'), emptyTxt = '<div class="empty">' + ($('comp-q').value.trim() ? 'Ничего не найдено' : 'Компаний пока нет. Нажмите «＋ Компания» или импортируйте из «Визы и договоры».') + '</div>';
    el.className = view === 'list' && comp.items.length ? 'list' : 'cgrid';
    el.innerHTML = !comp.items.length ? emptyTxt : view === 'list'
      ? tableHtml(['Название','ИНН','ОКПО','Директор','Адрес','Клиенты','Файлы'], comp.items.map(rowComp).join(''))
      : comp.items.map(cardComp).join('');
    $('comp-more').hidden = comp.items.length >= comp.total;
  }
  function loadComp(append){
    var p = new URLSearchParams(); p.set('limit', PAGE); p.set('offset', append ? comp.items.length : 0);
    if ($('comp-q').value.trim()) p.set('q', $('comp-q').value.trim());
    return api('GET', '/api/clients/companies?' + p.toString()).then(function(r){
      comp.items = append ? comp.items.concat(r.items) : r.items; comp.total = r.total; renderComp();
    }).catch(function(er){ $('comp-grid').innerHTML = '<div class="empty">' + esc(er.message) + '</div>'; });
  }

  // ----- карточки клиентов -----
  function cardCli(k, i){
    return '<div class="cc" tabindex="0" role="button" data-cli="' + i + '"><div class="nm">' + esc(k.name) + '</div>' +
      (k.position ? '<div class="full">' + esc(k.position) + '</div>' : '') +
      row('Телефон', k.phone) + row('Email', k.email) + row('Гражданство', k.citizenship) + row('Паспорт', k.passport) +
      (k.notes ? '<div class="full">' + esc(k.notes.length > 100 ? k.notes.slice(0, 100) + '…' : k.notes) + '</div>' : '') +
      '<div class="chips">' + (k.company_id ? '<button type="button" class="chip" data-gocomp="' + k.company_id + '" title="Открыть компанию">🏢 ' + esc(k.company_name) + '</button>' : '<span class="chip">без компании</span>') +
      (k.files_count ? '<span class="chip">📎 ' + k.files_count + '</span>' : '') + '</div></div>';
  }
  function renderCli(){
    var el = $('cli-grid'), emptyTxt = '<div class="empty">' + ($('cli-q').value.trim() || $('cli-company').value ? 'Ничего не найдено' : 'Клиентов пока нет. Нажмите «＋ Клиент».') + '</div>';
    el.className = view === 'list' && cli.items.length ? 'list' : 'cgrid';
    el.innerHTML = !cli.items.length ? emptyTxt : view === 'list'
      ? tableHtml(['ФИО','Компания','Должность','Телефон','Email','Паспорт','Файлы'], cli.items.map(rowCli).join(''))
      : cli.items.map(cardCli).join('');
    $('cli-more').hidden = cli.items.length >= cli.total;
  }
  function loadCli(append){
    var p = new URLSearchParams(); p.set('limit', PAGE); p.set('offset', append ? cli.items.length : 0);
    if ($('cli-q').value.trim()) p.set('q', $('cli-q').value.trim());
    if ($('cli-company').value) p.set('company_id', $('cli-company').value);
    return api('GET', '/api/clients/clients?' + p.toString()).then(function(r){
      cli.items = append ? cli.items.concat(r.items) : r.items; cli.total = r.total; renderCli();
    }).catch(function(er){ $('cli-grid').innerHTML = '<div class="empty">' + esc(er.message) + '</div>'; });
  }
  function loadCounts(){ return api('GET', '/api/clients/stats').then(function(s){ $('comp-count').textContent = s.companies; $('cli-count').textContent = s.clients; maxFileMb = s.max_file_mb || maxFileMb; }).catch(function(){}); }
  function setView(v){
    view = v; try { localStorage.setItem('bsp_view', v); } catch(e){}
    Array.prototype.forEach.call(document.querySelectorAll('.viewsw button'), function(b){ b.classList.toggle('on', b.getAttribute('data-view') === v); });
    if (dataLoaded) { renderComp(); renderCli(); }
  }
  Array.prototype.forEach.call(document.querySelectorAll('.viewsw button'), function(b){ b.onclick = function(){ setView(b.getAttribute('data-view')); }; });
  function reloadAll(){ return Promise.all([loadOptions(), loadComp(), loadCli(), loadCounts()]).then(function(r){ dataLoaded = true; return r; }); }

  var t1, t2;
  $('comp-q').addEventListener('input', function(){ clearTimeout(t1); t1 = setTimeout(function(){ loadComp(); }, 250); });
  $('cli-q').addEventListener('input', function(){ clearTimeout(t2); t2 = setTimeout(function(){ loadCli(); }, 250); });
  $('cli-company').addEventListener('change', function(){ loadCli(); });
  $('comp-more').onclick = function(){ loadComp(true); };
  $('cli-more').onclick = function(){ loadCli(true); };

  // клики по карточкам: открываем отдельную страницу
  function onCardClick(e){
    var chip = e.target.closest('[data-clients],[data-gocomp]');
    if (chip) {
      e.stopPropagation();
      if (chip.hasAttribute('data-clients')) { $('cli-q').value = ''; $('cli-company').value = chip.getAttribute('data-clients'); go('cli'); loadCli(); }
      else go('company/' + chip.getAttribute('data-gocomp'));
      return;
    }
    var c = e.target.closest('[data-comp],[data-cli]'); if (!c) return;
    if (c.hasAttribute('data-comp')) go('company/' + comp.items[Number(c.getAttribute('data-comp'))].id);
    else go('client/' + cli.items[Number(c.getAttribute('data-cli'))].id);
  }
  ['comp-grid','cli-grid'].forEach(function(id){
    $(id).addEventListener('click', onCardClick);
    $(id).addEventListener('keydown', function(e){ if ((e.key === 'Enter' || e.key === ' ') && (e.target.classList.contains('cc') || e.target.tagName === 'TR')) { e.preventDefault(); e.target.click(); } });
  });

  // ----- файлы в карточках -----
  function formatSize(b){ return b < 1024 ? b + ' Б' : b < 1048576 ? Math.round(b / 1024) + ' КБ' : (b / 1048576).toFixed(1) + ' МБ'; }
  function uploadFile(kind, id, file){
    if (file.size > maxFileMb * 1048576) return Promise.reject(new Error('«' + file.name + '» больше ' + maxFileMb + ' МБ'));
    return fetch('/api/clients/' + kind + '/' + id + '/files?name=' + encodeURIComponent(file.name), { method: 'POST', headers: {'Content-Type':'application/octet-stream'}, body: file })
      .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ if (!r.ok) throw new Error(j.error || ('Ошибка ' + r.status)); return j; }); });
  }
  // kind: 'companies' | 'clients'; p: префикс id элементов ('c' или 'k'); errId — куда писать ошибки
  function FilesBox(kind, p, errId){
    var owner = null, pending = [];
    var box = {
      open: function(rec){ owner = rec; pending = []; $(p + '-addfile').value = ''; return box.render(); },
      render: function(){
        $(p + '-files-hint').textContent = owner ? 'До ' + maxFileMb + ' МБ на файл. Хранятся без срока.' : 'Файлы загрузятся после сохранения карточки. До ' + maxFileMb + ' МБ на файл.';
        if (!owner) {
          $(p + '-files').innerHTML = pending.length ? pending.map(function(f, i){ return '<div class="frow"><span class="fn">📎 ' + esc(f.name) + '</span><span class="sub">' + formatSize(f.size) + '</span><button type="button" class="btn danger sm" data-unpend="' + i + '" title="Убрать">✕</button></div>'; }).join('') : '<div class="frow"><span class="sub">Файлов нет</span></div>';
          return Promise.resolve();
        }
        return api('GET', '/api/clients/' + kind + '/' + owner.id + '/files').then(function(list){
          $(p + '-files').innerHTML = list.length ? list.map(function(f){
            return '<div class="frow"><span class="fn" title="' + esc(f.name) + '">📎 ' + esc(f.name) + '</span><span class="sub">' + formatSize(f.size) + '</span>' +
              '<a class="btn ghost sm" href="/api/clients/files/' + f.id + '" title="Скачать">⬇</a><button type="button" class="btn danger sm" data-fdel="' + f.id + '" title="Удалить файл">🗑</button></div>';
          }).join('') : '<div class="frow"><span class="sub">Файлов нет</span></div>';
        });
      },
      // после создания карточки догружаем выбранные заранее файлы; возвращает список ошибок
      flush: function(id){
        var errs = [];
        return pending.reduce(function(chain, f){ return chain.then(function(){ return uploadFile(kind, id, f); }).catch(function(er){ errs.push(er.message); }); }, Promise.resolve()).then(function(){ pending = []; return errs; });
      }
    };
    $(p + '-addfile').addEventListener('change', function(){
      var files = Array.prototype.slice.call(this.files), inp = this; if (!files.length) return;
      $(errId).textContent = '';
      if (!owner) { pending = pending.concat(files); inp.value = ''; box.render(); return; }
      files.reduce(function(chain, f){ return chain.then(function(){ return uploadFile(kind, owner.id, f); }); }, Promise.resolve())
        .catch(function(er){ $(errId).textContent = er.message; })
        .then(function(){ inp.value = ''; return Promise.all([box.render(), reloadAll()]); });
    });
    $(p + '-files').addEventListener('click', function(e){
      var del = e.target.getAttribute('data-fdel'), un = e.target.getAttribute('data-unpend');
      if (un != null) { pending.splice(Number(un), 1); box.render(); }
      if (del && confirm('Удалить этот файл?')) api('DELETE', '/api/clients/files/' + del).then(function(){ return Promise.all([box.render(), reloadAll()]); }).catch(function(er){ $(errId).textContent = er.message; });
    });
    return box;
  }
  var compFiles = FilesBox('companies', 'c', 'dc-err'), cliFiles = FilesBox('clients', 'k', 'dl-err');

  // ----- страница компании -----
  function setCompanyTitle(){ $('dc-title').textContent = cur.rec ? cur.rec.name : 'Новая компания'; $('dc-sub').textContent = cur.rec ? 'Клиентов: ' + cur.rec.clients_count + ' · файлов: ' + cur.rec.files_count : 'Заполните данные и нажмите «Сохранить» — после этого можно добавлять клиентов'; }
  function renderCompanyClients(){
    var box = $('dc-clients');
    if (!cur.rec) { box.innerHTML = '<div class="sub" style="padding:.4rem 0">Появятся после сохранения компании</div>'; $('dc-add-client').hidden = true; return Promise.resolve(); }
    $('dc-add-client').hidden = false;
    return api('GET', '/api/clients/clients?limit=200&company_id=' + cur.rec.id).then(function(r){
      box.innerHTML = r.items.length ? r.items.map(function(k){ return '<div class="mini" data-client-id="' + k.id + '"><span>👤 ' + esc(k.name) + '</span><span class="sub">' + esc(k.position || k.phone || '') + '</span></div>'; }).join('') : '<div class="sub" style="padding:.4rem 0">Клиентов пока нет</div>';
    });
  }
  function showCompanyPage(id){
    $('dc-err').textContent = '';
    var load = id === 'new' ? Promise.resolve(null) : api('GET', '/api/clients/companies/' + Number(id));
    return load.then(function(rec){
      cur = { kind: 'company', rec: rec, dirty: false };
      COMP_FIELDS.forEach(function(f){ $('c-' + f).value = rec ? (rec[f] || '') : ''; });
      $('dc-del').hidden = !rec; setCompanyTitle();
      showPanel('company'); window.scrollTo(0, 0);
      return Promise.all([compFiles.open(rec), renderCompanyClients()]);
    }).catch(function(er){ toast(er.message); go('comp'); });
  }
  $('btn-add-comp').onclick = function(){ go('company/new'); };
  $('dc-back').onclick = function(){ go('comp'); };
  $('dc-add-client').onclick = function(){ go('client/new?company=' + cur.rec.id); };
  $('dc-clients').addEventListener('click', function(e){ var m = e.target.closest('[data-client-id]'); if (m) go('client/' + m.getAttribute('data-client-id')); });
  $('dc-save').onclick = function(){
    var body = {}; COMP_FIELDS.forEach(function(f){ body[f] = $('c-' + f).value; });
    var isNew = !cur.rec, btn = this; btn.disabled = true; $('dc-err').textContent = '';
    api(isNew ? 'POST' : 'PATCH', '/api/clients/companies' + (isNew ? '' : '/' + cur.rec.id), body)
      .then(function(saved){
        cur.dirty = false;
        return (isNew ? compFiles.flush(saved.id) : Promise.resolve([])).then(function(errs){
          toast(errs.length ? 'Сохранено, но не все файлы загрузились: ' + errs.join('; ') : 'Сохранено');
          if (isNew) { history.replaceState(null, '', '#company/' + saved.id); route(); }
          else { cur.rec = saved; setCompanyTitle(); }
          return reloadAll();
        });
      })
      .catch(function(er){ $('dc-err').textContent = er.message; }).then(function(){ btn.disabled = false; });
  };
  $('dc-del').onclick = function(){
    api('GET', '/api/clients/companies/' + cur.rec.id).then(function(c){
      if (!confirm('Удалить компанию «' + c.name + '»?' + (c.clients_count ? '\nКлиенты (' + c.clients_count + ') останутся в базе, но без компании.' : '') + (c.files_count ? '\nФайлы компании (' + c.files_count + ') будут удалены.' : '') + '\nЭто нельзя отменить.')) return;
      return api('DELETE', '/api/clients/companies/' + c.id).then(function(){ toast('Компания удалена'); cur.dirty = false; go('comp'); return reloadAll(); });
    }).catch(function(er){ $('dc-err').textContent = er.message; });
  };
  $('btn-import').onclick = function(){
    var b = this; b.disabled = true;
    api('POST', '/api/clients/companies/import-visa').then(function(r){ toast(r.added ? 'Добавлено компаний: ' + r.added : 'Новых компаний нет — всё уже импортировано'); return reloadAll(); })
      .catch(function(er){ toast(er.message); }).then(function(){ b.disabled = false; });
  };

  // ----- страница клиента -----
  function setClientTitle(){ $('dl-title').textContent = cur.rec ? cur.rec.name : 'Новый клиент'; $('dl-sub').textContent = cur.rec ? (cur.rec.company_name ? 'Компания: ' + cur.rec.company_name : 'Без компании') + ' · файлов: ' + cur.rec.files_count : 'Заполните данные и нажмите «Сохранить» — после этого можно добавлять файлы'; $('dl-open-co').hidden = !(cur.rec && cur.rec.company_id); }
  function showClientPage(id, presetCompany){
    $('dl-err').textContent = '';
    var load = id === 'new' ? Promise.resolve(null) : api('GET', '/api/clients/clients/' + Number(id));
    return Promise.all([load, loadOptions()]).then(function(r){
      var rec = r[0];
      cur = { kind: 'client', rec: rec, dirty: false };
      CLI_FIELDS.forEach(function(f){ $('k-' + f).value = rec ? (rec[f] || '') : ''; });
      $('k-company_id').innerHTML = companySelectHtml(rec ? rec.company_id : presetCompany);
      $('dl-del').hidden = !rec; setClientTitle();
      showPanel('client'); window.scrollTo(0, 0);
      return cliFiles.open(rec);
    }).catch(function(er){ toast(er.message); go('cli'); });
  }
  $('btn-add-cli').onclick = function(){ var f = $('cli-company').value; go('client/new' + (f && f !== 'none' ? '?company=' + f : '')); };
  $('dl-back').onclick = function(){ go('cli'); };
  $('dl-open-co').onclick = function(){ go('company/' + cur.rec.company_id); };
  $('dl-save').onclick = function(){
    var body = {}; CLI_FIELDS.forEach(function(f){ body[f] = $('k-' + f).value; }); body.company_id = $('k-company_id').value || null;
    var isNew = !cur.rec, btn = this; btn.disabled = true; $('dl-err').textContent = '';
    api(isNew ? 'POST' : 'PATCH', '/api/clients/clients' + (isNew ? '' : '/' + cur.rec.id), body)
      .then(function(saved){
        cur.dirty = false;
        return (isNew ? cliFiles.flush(saved.id) : Promise.resolve([])).then(function(errs){
          toast(errs.length ? 'Сохранено, но не все файлы загрузились: ' + errs.join('; ') : 'Сохранено');
          if (isNew) { history.replaceState(null, '', '#client/' + saved.id); route(); }
          else { cur.rec = saved; setClientTitle(); }
          return reloadAll();
        });
      })
      .catch(function(er){ $('dl-err').textContent = er.message; }).then(function(){ btn.disabled = false; });
  };
  $('dl-del').onclick = function(){
    api('GET', '/api/clients/clients/' + cur.rec.id).then(function(k){
      if (!confirm('Удалить клиента «' + k.name + '»?' + (k.files_count ? '\nФайлы клиента (' + k.files_count + ') будут удалены.' : '') + '\nЭто нельзя отменить.')) return;
      return api('DELETE', '/api/clients/clients/' + k.id).then(function(){ toast('Клиент удалён'); cur.dirty = false; go('cli'); return reloadAll(); });
    }).catch(function(er){ $('dl-err').textContent = er.message; });
  };

  // ----- маршрутизатор -----
  function route(){
    var h = (location.hash || '').replace('#', ''), m;
    if ((m = /^company\/(new|\d+)$/.exec(h))) return showCompanyPage(m[1]);
    if ((m = /^client\/(new|\d+)(?:\?company=(\d+))?$/.exec(h))) return showClientPage(m[1], m[2] || '');
    cur = { kind: null, rec: null, dirty: false };
    showPanel(h === 'cli' ? 'cli' : 'comp');
    if (dataLoaded) { loadComp(); loadCli(); loadCounts(); }   // подхватываем изменения со страницы карточки
  }

  // ----- настройки оформления -----
  $('btn-settings').onclick = function(){ AppTheme.renderGrid(); $('dlg-settings').showModal(); };
  $('settings-close').onclick = function(){ $('dlg-settings').close(); };
  $('theme-grid').addEventListener('click', function(e){ var b = e.target.closest('[data-theme]'); if (b) AppTheme.apply(b.getAttribute('data-theme')); });

  setView(view);
  route();
  reloadAll();
})();
</script>
</body>
</html>
