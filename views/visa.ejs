        </div>
        <div class="vrow2">
          <div class="fg"><label for="viz-submit">Дата подачи</label><input id="viz-submit" type="date" onchange="recalcReviewDate()" /></div>
          <div class="fg"><label for="viz-review">Дата рассмотрения</label><input id="viz-review" type="date" /></div>
        </div>
        <div class="fg"><label for="viz-exec">Исполнитель</label><div class="sw"><select id="viz-exec"></select></div></div>
        <div class="gen-area">
          <button class="btn bs" id="viz-submit-btn" onclick="submitVisaForm()">➕ Добавить запись</button>
