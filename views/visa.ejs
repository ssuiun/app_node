        <div class="ccn">${esc(c.id)}</div>
        <div class="ccname">${esc(c.name)}</div>
        <div class="cca">
          <button class="btn bg bsm" onclick="openM('${c.id}')">✏️</button>
          <button class="btn bd bsm" onclick="delC('${c.id}')">🗑️</button>
        </div>
      </div>
      <div class="cci">
        <div class="ir"><span class="il">Директор</span><span>${esc(c.director)}</span></div>
        <div class="ir"><span class="il">ИНН</span><span>${esc(c.inn)}</span></div>
        ${c.okpo?`<div class="ir"><span class="il">ОКПО</span><span>${esc(c.okpo)}</span></div>`:''}
        <div class="ir"><span class="il">Адрес</span><span>${esc(c.address)}</span></div>
        ${c.reg_date?`<div class="ir"><span class="il">Рег.</span><span>${esc(c.reg_date)}</span></div>`:''}
      </div>
      ${c.activity?`<div class="cbadge">${esc(c.activity.substring(0,60))}${c.activity.length>60?'...':''}</div>`:''}
