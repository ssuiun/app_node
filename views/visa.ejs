const EXECUTORS = ['Суйунбек','Адиля','Алтын'];
const VISA_TYPES = { 'Бизнес виза': 2, 'Рабочая виза': 7, 'Продление': 10 };
const VISA_STATUSES = [
  { v:'Новая заявка', cls:'st-new' },
  { v:'Возврат на доработку', cls:'st-revision' },
  { v:'Одобрена', cls:'st-approved' },
  { v:'Готова к выдаче', cls:'st-ready' }
];

let VDB = [];
let editingVisaId = null;

function loadVDB() {
  const s = localStorage.getItem('vd_visas');
  if (s) { try { VDB = JSON.parse(s); return; } catch(e){} }
  VDB = [];
}
function saveVDB() { localStorage.setItem('vd_visas', JSON.stringify(VDB)); }

function isoToday() {
  const d = new Date();
  return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
}
function isoPlusDays(iso, days) {
  const d = new Date(iso+'T00:00:00');
  d.setDate(d.getDate()+days);
  return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
}
function isoToRu(iso) {
  if (!iso) return '';
  const [y,m,d] = iso.split('-');
  return `${d}.${m}.${y}`;
}

function initVizForm() {
  const stSel = document.getElementById('viz-status');
  stSel.innerHTML = VISA_STATUSES.map(s => `<option value="${esc(s.v)}">${esc(s.v)}</option>`).join('');
  const tySel = document.getElementById('viz-type');
  tySel.innerHTML = Object.keys(VISA_TYPES).map(t => `<option value="${esc(t)}">${esc(t)}</option>`).join('');
  const exSel = document.getElementById('viz-exec');
  exSel.innerHTML = EXECUTORS.map(e => `<option value="${esc(e)}">${esc(e)}</option>`).join('');
  document.getElementById('viz-submit').value = isoToday();
  recalcReviewDate();
  const hook = localStorage.getItem('vd_hook') || '';
  document.getElementById('viz-hook').value = hook;
  document.getElementById('viz-secret').value = localStorage.getItem('vd_secret') || '';
  updateConnDot(hook ? null : 'unknown');
}

function recalcReviewDate() {
  const type = document.getElementById('viz-type').value;
  const submit = document.getElementById('viz-submit').value || isoToday();
  const days = VISA_TYPES[type] ?? 7;
  document.getElementById('viz-review').value = isoPlusDays(submit, days);
}

function statusMeta(v) {
  return VISA_STATUSES.find(s => s.v === v) || VISA_STATUSES[0];
}

function submitVisaForm() {
  const company = document.getElementById('viz-co').value.trim();
  const fio = document.getElementById('viz-fio').value.trim();
  const num = document.getElementById('viz-num').value.trim();
  const status = document.getElementById('viz-status').value;
  const type = document.getElementById('viz-type').value;
  const submit = document.getElementById('viz-submit').value || isoToday();
  const review = document.getElementById('viz-review').value || isoPlusDays(submit, VISA_TYPES[type] ?? 7);
  const exec = document.getElementById('viz-exec').value;

  if (!company || !fio) { toast('Укажите компанию и ФИО', 'err'); return; }

  if (editingVisaId) {
    const rec = VDB.find(x => x.id === editingVisaId);
    if (!rec) { cancelEditVisa(); return; }
    Object.assign(rec, { company, fio, num, status, type, submit, review, exec, synced: false });
    saveVDB();
    renderVisas();
    toast('Запись обновлена', 'ok');
    syncVisa(rec.id);
    cancelEditVisa();
  } else {
    const rec = {
      id: 'v' + Date.now(),
      company, fio, num, status, type,
      submit, review, exec,
      synced: false
    };
    VDB.unshift(rec);
    saveVDB();
    renderVisas();
    toast('Запись добавлена', 'ok');
    syncVisa(rec.id);
  }

  document.getElementById('viz-fio').value = '';
  document.getElementById('viz-num').value = '';
  document.getElementById('viz-co').value = '';
  document.getElementById('viz-submit').value = isoToday();
  recalcReviewDate();
}

/* Редактирование заполняет ту же форму вместо отдельной модалки — это уже
   существующая форма «Новая запись», submitVisaForm() сам решает,
   создавать новую запись или обновлять editingVisaId. */
function editVisa(id) {
  const r = VDB.find(x => x.id === id);
  if (!r) return;
  editingVisaId = id;
  document.getElementById('viz-co').value = r.company;
  document.getElementById('viz-fio').value = r.fio;
  document.getElementById('viz-num').value = r.num;
  document.getElementById('viz-status').value = r.status;
  document.getElementById('viz-type').value = r.type;
  document.getElementById('viz-submit').value = r.submit;
  document.getElementById('viz-review').value = r.review;
  document.getElementById('viz-exec').value = r.exec;
  document.getElementById('viz-submit-btn').textContent = '💾 Сохранить изменения';
  document.getElementById('viz-cancel-btn').style.display = '';
  toast('Измените поля и нажмите «Сохранить изменения»', 'ok');
}

function cancelEditVisa() {
  editingVisaId = null;
  document.getElementById('viz-submit-btn').textContent = '➕ Добавить запись';
  document.getElementById('viz-cancel-btn').style.display = 'none';
}

function delVisa(id) {
  const r = VDB.find(x => x.id === id);
  if (!r) return;
  if (!confirm(`Удалить запись "${r.fio}"? В самой Google Таблице строку нужно будет удалить вручную.`)) return;
  if (editingVisaId === id) cancelEditVisa();
  VDB = VDB.filter(x => x.id !== id);
  saveVDB();
  renderVisas();
  toast('Запись удалена локально', 'ok');
}

function renderVisas() {
  document.getElementById('viz-count').textContent = VDB.length;
  const thead = document.querySelector('#viz-table thead');
  const tbody = document.querySelector('#viz-table tbody');
  thead.innerHTML = `<tr>
    <th>Компания</th><th>ФИО</th><th>№ визы</th><th>Статус</th><th>Тип</th>
    <th>Подача</th><th>Рассмотрение</th><th>Исполнитель</th><th>Синхр.</th><th></th>
  </tr>`;
  if (!VDB.length) {
    tbody.innerHTML = `<tr><td colspan="10"><div class="vempty">Записей пока нет — заполните форму слева</div></td></tr>`;
    return;
  }
  tbody.innerHTML = VDB.map(r => {
    const sm = statusMeta(r.status);
    return `<tr>
      <td>${esc(r.company)}</td>
      <td>${esc(r.fio)}</td>
      <td>${esc(r.num)}</td>
      <td><span class="stbadge ${sm.cls}">${esc(r.status)}</span></td>
      <td>${esc(r.type)}</td>
      <td>${isoToRu(r.submit)}</td>
      <td>${isoToRu(r.review)}</td>
      <td>${esc(r.exec)}</td>
      <td>${r.synced ? '<span class="synced">✅ в таблице</span>' : `<span class="notsynced" onclick="syncVisa('${r.id}')">⟳ повторить</span>`}</td>
      <td style="white-space:nowrap"><button class="btn bg bsm" onclick="editVisa('${r.id}')" title="Редактировать">✏️</button> <button class="btn bd bsm" onclick="delVisa('${r.id}')" title="Удалить">🗑️</button></td>
    </tr>`;
  }).join('');
}

/* ═══ GOOGLE SHEETS SYNC (через Apps Script Web App) ═══ */
function saveHook() {
  const v = document.getElementById('viz-hook').value.trim();
  const s = document.getElementById('viz-secret').value.trim();
  localStorage.setItem('vd_hook', v);
  localStorage.setItem('vd_secret', s);
  updateConnDot('unknown');
}
function updateConnDot(state) {
  const dot = document.getElementById('viz-conn-dot');
  const txt = document.getElementById('viz-conn-txt');
  dot.className = 'conn-dot';
  if (state === 'ok') { dot.classList.add('ok'); txt.textContent = 'Подключено'; }
  else if (state === 'bad') { dot.classList.add('bad'); txt.textContent = 'Не удалось подключиться'; }
  else { txt.textContent = 'Соединение не проверено'; }
}
async function testHook() {
  const url = (document.getElementById('viz-hook').value || '').trim();
  const secret = (document.getElementById('viz-secret').value || '').trim();
  if (!url) { toast('Вставьте сначала URL веб-приложения', 'err'); return; }
  try {
    const res = await fetch(url + (secret ? (url.includes('?') ? '&' : '?') + 'secret=' + encodeURIComponent(secret) : ''), { method: 'GET' });
    const data = await res.json().catch(() => null);
    if (res.ok && data && data.ok) {
      updateConnDot('ok');
      toast('Соединение с таблицей установлено', 'ok');
    } else {
      updateConnDot('bad');
      toast('Мост ответил, но неожиданно. Проверьте деплой скрипта.', 'err');
    }
  } catch(e) {
    updateConnDot('bad');
    toast('Не удалось связаться с веб-приложением. Проверьте URL и деплой.', 'err');
  }
}
async function syncVisa(id) {
  const url = (localStorage.getItem('vd_hook') || '').trim();
  const secret = (localStorage.getItem('vd_secret') || '').trim();
  const rec = VDB.find(x => x.id === id);
  if (!rec) return;
  if (!url) { toast('Сначала укажите URL Apps Script веб-приложения', 'err'); return; }
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({
        secret,
        company: rec.company, fio: rec.fio, visaNumber: rec.num,
        status: rec.status, visaType: rec.type,
        submitDate: isoToRu(rec.submit), reviewDate: isoToRu(rec.review),
        executor: rec.exec
      })
    });
    const data = await res.json().catch(() => null);
    if (res.ok && data && data.ok) {
      rec.synced = true;
      saveVDB();
      renderVisas();
      updateConnDot('ok');
      toast('Запись отправлена в Google Таблицу', 'ok');
    } else {
      updateConnDot('bad');
      toast('Не удалось записать в таблицу: ' + (data && data.error ? data.error : 'см. деплой скрипта'), 'err');
    }
  } catch(e) {
    updateConnDot('bad');
    toast('Ошибка сети при отправке в таблицу. Запись сохранена локально.', 'err');
  }
}

/* ═══ TEMPLATE LOADING ═══ */
function loadTpl(p, inp) {
  const f = inp.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = e => {
    TPL[p] = e.target.result;
    document.getElementById(p+'-zone').classList.add('loaded');
    document.getElementById(p+'-icon').textContent = '✅';
    document.getElementById(p+'-fname').textContent = f.name;
    document.getElementById(p+'-st').textContent = 'Шаблон загружен: ' + f.name;
    document.getElementById(p+'-dot').classList.replace('no','ok');
    document.getElementById(p+'-hint').style.display = 'none';
    updateResetBtn(p, true);
    updateGenBtn(p);
    try {
      localStorage.setItem('vd_tpl_'+p, abToB64(e.target.result));
      localStorage.setItem('vd_tplname_'+p, f.name);
      toast('Шаблон загружен и сохранён: ' + f.name, 'ok');
    } catch(err) {
      console.error('Не удалось сохранить шаблон в хранилище браузера', err);
      toast('Шаблон загружен, но не поместился в память браузера — после перезагрузки страницы придётся загрузить его заново', 'err');
    }
  };
  r.readAsArrayBuffer(f);
}
function updateResetBtn(p, isCustom) {
  const btn = document.getElementById(p+'-reset');
  if (btn) btn.style.display = isCustom ? 'inline-flex' : 'none';
}
/* Кнопка «Скачать .docx» была всегда кликабельной, даже без загруженного
   шаблона — ошибка была видна только по тосту постфактум. Теперь блокируем
   её заранее и снимаем блокировку, как только TPL[p] реально заполнен. */
function updateGenBtn(p) {
  const btn = document.getElementById(p+'-gen');
  if (btn) btn.disabled = !TPL[p];
}
function resetTpl(p, silent) {
  localStorage.removeItem('vd_tpl_'+p);
  localStorage.removeItem('vd_tplname_'+p);
  try {
    TPL[p] = b64ToArrayBuffer(EMBEDDED_TPL[p]);
    document.getElementById(p+'-zone').classList.add('loaded');
    document.getElementById(p+'-icon').textContent = '✅';
    document.getElementById(p+'-fname').textContent = 'Встроенный шаблон готов';
    document.getElementById(p+'-st').textContent = 'Шаблон загружен (по умолчанию)';
    document.getElementById(p+'-dot').classList.replace('no','ok');
    document.getElementById(p+'-hint').style.display = 'none';
  } catch(e) {
    console.error('Ошибка восстановления встроенного шаблона', p, e);
  }
  updateResetBtn(p, false);
  updateGenBtn(p);
  if (!silent) toast('Восстановлен встроенный шаблон', 'ok');
}

/* ═══ DOCX GENERATION ═══ */
function trimTagParser(tag) {
  // Делает теги устойчивыми к пробелам вида {{ company_name }} —
  // иначе docxtemplater ищет ключ " company_name " (с пробелами) и не находит его,
  // из-за чего все поля в документе оставались пустыми.
  const cleanTag = tag.trim();
  return {
    get(scope) {
      if (cleanTag === '.' || cleanTag === '') return scope;
      return scope[cleanTag];
    }
  };
}
function makeDocx(tplBuf, ctx, delimStart, delimEnd) {
  try {
    const zip = new PizZip(tplBuf);
    const DocxtemplaterCtor = window.docxtemplater || window.Docxtemplater ||
      (window.docxtemplater && window.docxtemplater.default) ||
      (window.Docxtemplater && window.Docxtemplater.default);
    if (typeof DocxtemplaterCtor !== 'function') {
      toast('Библиотека docxtemplater не загрузилась. Проверьте интернет-соединение и обновите страницу (F5).', 'err');
      return null;
    }
    const doc = new DocxtemplaterCtor(zip, {
      paragraphLoop: true,
      linebreaks: true,
      delimiters: { start: delimStart, end: delimEnd },
      parser: trimTagParser,
      nullGetter: () => ''
    });
    doc.render(ctx);
    return doc.getZip().generate({
      type: 'blob',
      mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    });
  } catch(e) {
    console.error('docx error', e);
    toast('Ошибка генерации: ' + (e.message||e), 'err');
    return null;
  }
}

function download(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 3000);
}

