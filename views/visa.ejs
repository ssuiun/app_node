/* Вырезает нижнюю часть фото (где обычно находится MRZ) и увеличивает её —
   мелкий текст MRZ распознаётся намного надёжнее на увеличенном, обрезанном
   фрагменте, чем на фото всего разворота целиком. */
function cropBottom(imgSrc, fracTop, scale) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      try {
        const cropY = Math.floor(img.height * fracTop);
        const cropH = img.height - cropY;
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(cropH * scale);
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, cropY, img.width, cropH, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL('image/png'));
      } catch (e) { reject(e); }
    };
    img.onerror = reject;
    img.src = imgSrc;
  });
}

async function runOcr(imgSrc) {
  const statusEl = document.getElementById('scan-status');
  const spin = document.getElementById('scan-spinner');
  const txt = document.getElementById('scan-status-txt');
  statusEl.style.display = 'flex';
  spin.classList.add('show');
  let worker = null;
  try {
    if (typeof Tesseract === 'undefined') {
      throw new Error('Библиотека распознавания не загрузилась (проверьте интернет-соединение)');
    }

    worker = await Tesseract.createWorker('eng');

    // Проход 1: MRZ — обрезаем нижние ~22% фото (где строки MRZ), увеличиваем в 3 раза
    // и ограничиваем алфавит только буквами/цифрами/"<", как в самой MRZ.
    // Это резко снижает число ошибок вида "<" → "O"/"C" и т.п.
    txt.textContent = 'Ищу машиночитаемую зону (MRZ)...';
    let mrzText = '';
    try {
      const mrzImg = await cropBottom(imgSrc, 0.78, 3);
      await worker.setParameters({
        tessedit_char_whitelist: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<',
        tessedit_pageseg_mode: '6' // SINGLE_BLOCK — подходит для 2 плотных строк MRZ
      });
      const mrzRes = await worker.recognize(mrzImg);
      mrzText = mrzRes.data.text || '';
    } catch (e) { console.warn('MRZ pass failed', e); }

    let parsed = parseMRZ(mrzText);

    // Проход 2: всё фото целиком (без ограничения алфавита) — резерв,
    // если MRZ не нашлась или не прошла проверку контрольных цифр:
    // берём напечатанные поля "Name" / "Passport No".
    if (!parsed.mrzFound || !parsed.checksumOk) {
      txt.textContent = 'Дополнительно проверяю напечатанные поля...';
      try {
        await worker.setParameters({ tessedit_char_whitelist: '', tessedit_pageseg_mode: '3' });
        const { data } = await worker.recognize(imgSrc);
        const viz = parseVIZ(data.text || '');
        if (!parsed.surname && viz.surname) parsed.surname = viz.surname;
        if (!parsed.given && viz.given) parsed.given = viz.given;
        if ((!parsed.passport || !parsed.checksumOk) && viz.passport) parsed.passport = viz.passport;
      } catch (e) { console.warn('VIZ pass failed', e); }
    }

    document.getElementById('scan-surname').value = parsed.surname;
    document.getElementById('scan-given').value = parsed.given;
    document.getElementById('scan-passport').value = parsed.passport;
    spin.classList.remove('show');

    if (parsed.mrzFound && parsed.checksumOk) {
      txt.textContent = 'Готово — данные подтверждены контрольной цифрой MRZ';
      toast('Данные распознаны и проверены', 'ok');
    } else if (parsed.surname || parsed.given || parsed.passport) {
      txt.textContent = 'Готово, но проверьте данные вручную — распознавание не идеально';
      toast('Распознано частично, проверьте поля', 'err');
    } else {
      txt.textContent = 'Не удалось распознать — введите данные вручную';
      toast('Не удалось распознать фото, заполните поля вручную', 'err');
    }
  } catch (e) {
    console.error('OCR error', e);
    spin.classList.remove('show');
    txt.textContent = 'Не удалось распознать — введите данные вручную';
    toast('Ошибка распознавания: ' + (e.message || e), 'err');
  } finally {
    if (worker) { try { await worker.terminate(); } catch(e) {} }
  }
}

/* ═══ MRZ: контрольные цифры (ICAO 9303) ═══ */
function mrzCharValue(ch) {
  if (ch === '<') return 0;
  if (ch >= '0' && ch <= '9') return ch.charCodeAt(0) - 48;
  if (ch >= 'A' && ch <= 'Z') return ch.charCodeAt(0) - 55; // A=10 ... Z=35
  return 0;
}
function mrzCheckDigit(str) {
  const w = [7, 3, 1];
  let sum = 0;
  for (let i = 0; i < str.length; i++) sum += mrzCharValue(str[i]) * w[i % 3];
  return sum % 10;
}
// В полях, которые обязаны быть только цифрами (даты, контрольные цифры),
// частые OCR-ошибки: O/D/Q→0, I/L→1, S→5, B→8, Z→2, G→6.
function digitsOnly(str) {
  const map = { O:'0', D:'0', Q:'0', I:'1', L:'1', S:'5', B:'8', Z:'2', G:'6', T:'7' };
  return str.split('').map(c => /[0-9]/.test(c) ? c : (map[c] || c)).join('');
}
// Приводит "мусорные" символы (пробелы, точки и т.п.), которые OCR иногда
// подставляет вместо заполнителя "<", обратно к "<".
function normalizeMrzLine(l) {
  return l.toUpperCase().replace(/[^A-Z0-9<]/g, '<');
}

function parseMRZ(raw) {
  const upper = raw.toUpperCase();
  const rawLines = upper.split(/\r?\n/).map(l => l.replace(/\s+/g, '')).filter(Boolean);
  const lines = rawLines.map(normalizeMrzLine).filter(l => l.length >= 20);

  let surname = '', given = '', passport = '', mrzFound = false, checksumOk = false;

  for (let i = 0; i < lines.length - 1; i++) {
    let l1 = lines[i];
    let l2 = lines[i + 1];
    if (!/^P/.test(l1)) continue;
    // Приводим строки к стандартной длине TD3 (44 символа) — паспорт РФ/КНР
    // и большинства стран использует именно этот формат.
    l1 = (l1 + '<'.repeat(44)).slice(0, 44);
    l2 = (l2 + '<'.repeat(44)).slice(0, 44);
    if (!l1.includes('<<')) continue;

    const namesPart = l1.slice(5); // после "P<" + код страны (3 буквы)
    const parts = namesPart.split('<<').filter(Boolean);
    surname = (parts[0] || '').replace(/</g, ' ').trim();
    given = (parts[1] || '').replace(/</g, ' ').trim();
    mrzFound = !!(surname || given);

    // Строка 2: номер паспорта(9) + контр.цифра(1) + гражданство(3) +
    // дата рожд.(6) + контр.цифра(1) + пол(1) + срок действия(6) + контр.цифра(1) + ...
    const passportRaw = l2.slice(0, 9);
    const passportCheck = l2[9];
    const birth = digitsOnly(l2.slice(13, 19));
    const birthCheck = digitsOnly(l2[19] || '');
    const expiry = digitsOnly(l2.slice(21, 27));
    const expiryCheck = digitsOnly(l2[27] || '');

    passport = passportRaw.replace(/</g, '').trim();

    const passOk = passportCheck !== undefined && String(mrzCheckDigit(passportRaw)) === passportCheck;
    const birthOk = birthCheck && String(mrzCheckDigit(birth)) === birthCheck;
    const expiryOk = expiryCheck && String(mrzCheckDigit(expiry)) === expiryCheck;
    checksumOk = !!(passOk && birthOk && expiryOk);
    break;
  }

  return { surname, given, passport, mrzFound, checksumOk };
}

/* ═══ Резерв: печатные поля паспорта (VIZ) ═══ */
function parseVIZ(raw) {
  const upper = raw.toUpperCase();
  let surname = '', given = '', passport = '';

  // "Name" в китайских паспортах печатается как "SURNAME, GIVENNAME"
  const nameMatch = upper.match(/\b([A-Z]{2,25}),\s*([A-Z]{2,25})\b/);
  if (nameMatch) { surname = nameMatch[1]; given = nameMatch[2]; }

  // Типовой номер китайского паспорта: 1-2 буквы + 7-8 цифр (например EJ2990251)
  const passMatch = upper.match(/\b[A-Z]{1,2}\d{7,8}\b/);
  if (passMatch) passport = passMatch[0];

  return { surname, given, passport };
}

