function getPriemCtx() {
  const cId = document.getElementById('priem-co').value;
  const c = cId ? getC(cId) : null;
  return {
    company_name: c ? c.name : '',
    company_address: c ? c.address : '',
    company_INN: c ? ('ИНН: '+c.inn+(c.okpo ? '; ОКПО: '+c.okpo : '')) : '',
    FULL_NAME: document.getElementById('priem-name').value.trim(),
    POSITION: document.getElementById('priem-pos').value.trim(),
    DIRECTOR: c ? c.director : '',
    TODAY: document.getElementById('priem-today').value.trim(),
    ORDER_NUM: document.getElementById('priem-num').value.trim(),
    data_from: document.getElementById('priem-from').value.trim()
  };
}
function upPriem() {
  const x = getPriemCtx();
  const el = document.getElementById('priem-out');
  if (!x.FULL_NAME && !x.company_name) { el.innerHTML='<div class="opl">Выберите компанию и заполните данные</div>'; return; }
  const p = v => v||'[не указано]';
  el.textContent = `ПРИКАЗ №${p(x.ORDER_NUM)}
════════════════════════════════════════
${p(c_full(x))}
${p(x.company_address)}
${p(x.company_INN)}

от ${p(x.TODAY)}.
Приказ №${p(x.ORDER_NUM)} от ${p(x.data_from)}

     Принять на работу ${p(x.FULL_NAME)} на должность ${p(x.POSITION)}

────────────────────────────────────────
Генеральный директор                              ${p(x.DIRECTOR)}`;
}
function c_full(x) { return x.company_name ? '«'+x.company_name+'»' : ''; }
function genPriem() {
  if (!TPL.priem) { toast('Сначала загрузите шаблон .docx', 'err'); return; }
  const x = getPriemCtx();
  const blob = makeDocxMixed(TPL.priem, x);
  if (blob) {
    const name = 'Приказ_о_приёме_' + (x.FULL_NAME||'документ').replace(/[^a-zA-Zа-яА-Я0-9]/g,'_') + '.docx';
    download(blob, name);
    toast('Файл скачан: ' + name, 'ok');
  }
}

