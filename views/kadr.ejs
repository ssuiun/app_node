let currentTheme = 'violet';
function applyTheme(key, save) {
  const t = THEMES[key];
  if (!t) return;
  const root = document.documentElement.style;
  Object.entries(t.vars).forEach(([k,v]) => root.setProperty(k, v));
  currentTheme = key;
  if (save !== false) localStorage.setItem('kd_theme', key);
  renderThemeGrid();
}
function loadTheme() {
  const saved = localStorage.getItem('kd_theme');
  applyTheme((saved && THEMES[saved]) ? saved : 'violet', false);
}
function renderThemeGrid() {
  const g = document.getElementById('theme-grid');
  if (!g) return;
  g.innerHTML = Object.entries(THEMES).map(([k,t]) => `
    <div class="theme-opt ${k===currentTheme?'sel':''}" onclick="applyTheme('${k}')">
      <div class="theme-sw" style="background:linear-gradient(135deg, ${t.vars['--acc']}, ${t.vars['--acc2']})"></div>
      <span>${t.name}</span>
    </div>`).join('');
}
