  el.textContent = `ПРИКАЗ №${p(x.ORDER_NUM)}
════════════════════════════════════════
${p(c_full(x))}
${p(x.company_address)}
${p(x.company_INN)}

от ${p(x.TODAY)}.
Приказ №${p(x.ORDER_NUM)} от ${p(x.data_from)}

      Уволить ${p(x.FULL_NAME)} с должности ${p(x.POSITION)} по собственному желанию

Основание: Заявление ${p(x.FULL_NAME)} а от ${p(x.data_from)}

────────────────────────────────────────
Генеральный директор                              ${p(x.DIRECTOR)}`;
