    const name = 'Приказ_об_увольнении_' + (x.FULL_NAME||'документ').replace(/[^a-zA-Zа-яА-Я0-9]/g,'_') + '.docx';
    download(blob, name);
    toast('Файл скачан: ' + name, 'ok');
