/* ═══ COPY ═══ */
function copyOut(id) {
  const t = document.getElementById(id).innerText;
  if (!t || t.includes('Выберите компанию')) { toast('Нечего копировать', 'err'); return; }
  navigator.clipboard.writeText(t).then(() => toast('Скопировано!', 'ok'));
}

/* ═══ COMPANIES ═══ */
function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function renderComp() {
  const q = (document.getElementById('search').value||'').toLowerCase();
  const list = DB.filter(c =>
    c.name.toLowerCase().includes(q) ||
    (c.full_name||'').toLowerCase().includes(q) ||
    (c.inn||'').includes(q) ||
    (c.director||'').toLowerCase().includes(q)
  );
  document.getElementById('stats').innerHTML =
    `<div class="chip">Всего: <strong>${DB.length}</strong></div>${q?`<div class="chip">Найдено: <strong>${list.length}</strong></div>`:''}`;
  const g = document.getElementById('cgrid');
  if (!list.length) { g.innerHTML='<div class="nores">🔍 Компании не найдены</div>'; return; }
  g.innerHTML = list.map(c=>`
    <div class="cc">
      <div class="cch">
        <div class="ccn">${esc(c.id)}</div>
        <div class="ccname">${esc(c.name)}</div>
        <div class="cca">
          <button class="btn bg bsm" onclick="openM('${c.id}')">✏️</button>
          <button class="btn bd bsm" onclick="delC('${c.id}')">🗑️</button>
        </div>
      </div>
      <div class="cci">
        <div class="ir"><span class="il">Директор</span><span>${esc(c.director)}</span></div>
        <div class="ir"><span class="il">ИНН</span><span>${esc(c.inn)}</span></div>
        ${c.okpo?`<div class="ir"><span class="il">ОКПО</span><span>${esc(c.okpo)}</span></div>`:''}
        <div class="ir"><span class="il">Адрес</span><span>${esc(c.address)}</span></div>
        ${c.reg_date?`<div class="ir"><span class="il">Рег.</span><span>${esc(c.reg_date)}</span></div>`:''}
      </div>
      ${c.activity?`<div class="cbadge">${esc(c.activity.substring(0,60))}${c.activity.length>60?'...':''}</div>`:''}
    </div>`).join('');
}

function openM(id=null) {
  editId = id;
  document.getElementById('mtitle').textContent = id ? 'Редактировать' : 'Добавить компанию';
  document.getElementById('msave').textContent = id ? 'Сохранить' : 'Добавить';
  if (id) {
    const c = getC(id); if(!c) return;
    document.getElementById('cf-n').value = c.name||'';
    document.getElementById('cf-fn').value = c.full_name||'';
    document.getElementById('cf-addr').value = c.address||'';
    document.getElementById('cf-info').value = c.info||'';
    document.getElementById('cf-act').value = c.activity||'';
    document.getElementById('cf-inn').value = c.inn||'';
    document.getElementById('cf-okpo').value = c.okpo||'';
    document.getElementById('cf-rt').value = c.reg_type||'зарегистрирована';
    document.getElementById('cf-rd').value = c.reg_date||'';
    document.getElementById('cf-rn').value = c.reg_num||'';
    document.getElementById('cf-dir').value = c.director||'';
  } else {
    document.getElementById('mform').reset();
  }
  document.getElementById('mov').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeM() { document.getElementById('mov').classList.remove('open'); document.body.style.overflow=''; editId=null; }
function clickOv(e) { if(e.target===document.getElementById('mov')) closeM(); }

function saveC(e) {
  e.preventDefault();
  const d = {
    name: document.getElementById('cf-n').value.trim(),
    full_name: document.getElementById('cf-fn').value.trim(),
    address: document.getElementById('cf-addr').value.trim(),
    info: document.getElementById('cf-info').value.trim(),
    activity: document.getElementById('cf-act').value.trim(),
    inn: document.getElementById('cf-inn').value.trim(),
    okpo: document.getElementById('cf-okpo').value.trim(),
    reg_type: document.getElementById('cf-rt').value,
    reg_date: document.getElementById('cf-rd').value.trim(),
    reg_num: document.getElementById('cf-rn').value.trim(),
    director: document.getElementById('cf-dir').value.trim()
  };
  if (editId) {
    const i = DB.findIndex(c=>c.id===editId);
    if(i!==-1) DB[i]={...DB[i],...d};
    toast('Компания обновлена!','ok');
  } else {
    d.id = String(DB.reduce((m,c)=>Math.max(m,parseInt(c.id)||0),0)+1);
    DB.push(d);
    toast('Компания добавлена!','ok');
  }
  saveDB(); fillSels(); renderComp(); closeM();
}
function delC(id) {
  const c=getC(id); if(!c) return;
  if(!confirm(`Удалить "${c.name}"?`)) return;
  DB=DB.filter(x=>x.id!==id);
  saveDB(); fillSels(); renderComp();
  toast('Удалено','ok');
}

/* ═══ ЭКСПОРТ / ИМПОРТ БАЗЫ КОМПАНИЙ ═══
   Данные живут только в localStorage этого браузера — экспорт/импорт нужен,
   чтобы делать бэкапы и передавать базу между исполнителями (и между этим
   приложением и «Визовыми документами» — структура базы у них одинаковая). */
function exportDB() {
  const blob = new Blob([JSON.stringify(DB, null, 2)], { type: 'application/json' });
  const stamp = today().replace(/\./g, '-');
  download(blob, `компании_${stamp}.json`);
  toast('База компаний экспортирована', 'ok');
}
function importDB(inp) {
  const f = inp.files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = e => {
    let incoming;
    try {
      incoming = JSON.parse(e.target.result);
      if (!Array.isArray(incoming)) throw new Error('not an array');
    } catch (err) {
      toast('Файл не похож на экспорт базы компаний (ожидается JSON-массив)', 'err');
      inp.value = '';
      return;
    }
    let added = 0, updated = 0;
    incoming.forEach(c => {
      if (!c || typeof c !== 'object' || !c.id) return;
      const i = DB.findIndex(x => x.id === c.id);
      if (i !== -1) { DB[i] = { ...DB[i], ...c }; updated++; }
      else { DB.push(c); added++; }
    });
    saveDB(); fillSels(); renderComp();
    toast(`Импортировано: добавлено ${added}, обновлено ${updated}`, 'ok');
    inp.value = '';
  };
  r.readAsText(f);
}

/* ═══ TOAST ═══ */
function toast(msg, type='ok') {
  const t=document.getElementById('toast');
  document.getElementById('ti').textContent = type==='ok'?'✅':'❌';
  document.getElementById('tm').textContent = msg;
  t.className='toast '+type+' show';
  setTimeout(()=>t.classList.remove('show'),3500);
}

/* ═══ INIT ═══ */
function initEmbeddedTemplates() {
  ['priem','uvol','otpusk'].forEach(p => {
    try {
      TPL[p] = b64ToArrayBuffer(EMBEDDED_TPL[p]);
    } catch(e) {
      console.error('Ошибка загрузки встроенного шаблона', p, e);
      document.getElementById(p+'-zone').classList.remove('loaded');
      document.getElementById(p+'-icon').textContent = '📂';
      document.getElementById(p+'-fname').textContent = 'Нажмите чтобы выбрать файл';
      document.getElementById(p+'-dot').classList.replace('ok','no');
      document.getElementById(p+'-st').textContent = 'Шаблон не загружен';
      document.getElementById(p+'-hint').style.display = '';
    }
    updateGenBtn(p);
  });
}
function checkLibraries() {
  const hasPizZip = typeof window.PizZip === 'function';
  const hasDocx = typeof window.docxtemplater === 'function' || typeof window.Docxtemplater === 'function' ||
    (window.docxtemplater && typeof window.docxtemplater.default === 'function') ||
    (window.Docxtemplater && typeof window.Docxtemplater.default === 'function');
  if (!hasPizZip || !hasDocx) {
    toast('Не удалось загрузить библиотеки для генерации .docx. Проверьте интернет-соединение и обновите страницу (F5).', 'err');
  }
}
document.addEventListener('DOMContentLoaded', ()=>{
  loadDB(); fillSels(); renderComp(); initEmbeddedTemplates();
  document.getElementById('priem-today').value = today();
  document.getElementById('uvol-today').value = today();
  document.getElementById('otpusk-today').value = today();
  setTimeout(checkLibraries, 1200);
});
</script>
