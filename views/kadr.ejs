/* ═══ DOCX GENERATION ═══
   Шаблоны содержат ДВА типа плейсхолдеров одновременно:
   {{ company_x }} — данные компании, и {FIELD} — данные сотрудника.
   Docxtemplater поддерживает только один набор разделителей за раз,
   поэтому рендерим документ в ДВА прохода: сперва {{ }}, затем { }. */
function trimTagParser(tag) {
  const cleanTag = tag.trim();
  return {
    get(scope) {
      if (cleanTag === '.' || cleanTag === '') return scope;
      return scope[cleanTag];
    }
  };
}
function renderPass(buf, ctx, start, end) {
  const zip = new PizZip(buf);
  const DocxtemplaterCtor = window.docxtemplater || window.Docxtemplater ||
    (window.docxtemplater && window.docxtemplater.default) ||
    (window.Docxtemplater && window.Docxtemplater.default);
  if (typeof DocxtemplaterCtor !== 'function') {
    throw new Error('Библиотека docxtemplater не загрузилась. Проверьте интернет-соединение и обновите страницу (F5).');
  }
  const doc = new DocxtemplaterCtor(zip, {
    paragraphLoop: true,
    linebreaks: true,
    delimiters: { start, end },
    parser: trimTagParser,
    nullGetter: () => ''
  });
  doc.render(ctx);
  return doc.getZip().generate({ type: 'arraybuffer' });
}
function makeDocxMixed(tplBuf, ctx) {
  try {
    let buf = renderPass(tplBuf, ctx, '{{', '}}');  // 1) компания
    buf = renderPass(buf, ctx, '{', '}');            // 2) сотрудник
    return new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' });
  } catch(e) {
    console.error('docx error', e);
    toast('Ошибка генерации: ' + (e.message||e), 'err');
    return null;
  }
}

function download(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 3000);
}

