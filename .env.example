# Скопируйте в .env:  cp .env.example .env
DATABASE_URL=postgres://app:app@localhost:5432/app
PORT=3000
# Тулбар Agentation (визуальные комментарии); уберите строку, чтобы выключить
AGENTATION=1
# Исходящие номера: хранение файлов (необязательно)
# OUT_FILE_RETENTION_DAYS=60
# OUT_FILE_WARN_DAYS=14
# OUT_MAX_FILE_MB=25
